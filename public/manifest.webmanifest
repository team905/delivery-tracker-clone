{
  "name": "QuickGo — Delivery & Live Tracking",
  "short_name": "QuickGo",
  "description": "Order food, groceries, cabs and parcels — and watch them arrive in real time.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#ffffff",
  "theme_color": "#ef4f5e",
  "categories": ["food", "shopping", "travel", "lifestyle"],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Order food", "short_name": "Food", "url": "/food.html", "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }] },
    { "name": "Book a cab", "short_name": "Cab", "url": "/cab.html", "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }] },
    { "name": "Quick groceries", "short_name": "Grocery", "url": "/grocery.html", "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }] },
    { "name": "Track an order", "short_name": "Track", "url": "/track.html", "icons": [{ "src": "/icons/icon.svg", "sizes": "any" }] }
  ],
  "prefer_related_applications": false
}
